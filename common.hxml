# Settings shared by the JVM build (global.hxml) and the PHP build (php.hxml).
-cp src
-resource cms.json@hx.press.version
-resource resources/lang/en.json@lang.en
-resource resources/lang/tr.json@lang.tr
-resource resources/themes/simple/cms-package.json@hx.press.theme.simple
-resource resources/themes/simple/lang/en.json@hx.press.theme.simple.lang.en
-resource resources/themes/simple/lang/tr.json@hx.press.theme.simple.lang.tr
# JVM plugins load the standard library from the application, so its classes stay whole.
-dce no
-D analyzer-optimize
-D scriptable
-D env_file=.env
-D hxwell_config_package=hx.press.config
-lib wellout
# The theme design skill the MCP server serves; see hx.press.mcp.McpSkills.
-resource mcp/skills/haxepress-theme-design/SKILL.md@mcp.skill.SKILL.md
-resource mcp/skills/haxepress-theme-design/references/document-model.md@mcp.skill.references/document-model.md
-resource mcp/skills/haxepress-theme-design/references/edit-operations.md@mcp.skill.references/edit-operations.md
-resource mcp/skills/haxepress-theme-design/references/rendered-markup.md@mcp.skill.references/rendered-markup.md
-resource mcp/skills/haxepress-theme-design/references/visual-review.md@mcp.skill.references/visual-review.md
