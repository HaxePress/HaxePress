diff --git a/src/hx/well/inertia/JvmHttp.hx b/src/hx/well/inertia/JvmHttp.hx
new file mode 100644
--- /dev/null
+++ b/src/hx/well/inertia/JvmHttp.hx
@@ -0,0 +1,73 @@
+package hx.well.inertia;
+
+import haxe.io.Bytes;
+import java.io.ByteArrayOutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+
+/** Native JVM HTTP transport, independent of Haxe socket overrides. */
+class JvmHttp {
+    var url:String;
+    var headers:Map<String, String> = new Map();
+    var postData:String = "";
+
+    public var cnxTimeout:Float = 2;
+    public var onData:String->Void = function(_) {};
+    public var onError:String->Void = function(_) {};
+    public var onStatus:Int->Void = function(_) {};
+
+    public function new(url:String) {
+        this.url = url;
+    }
+
+    public function setHeader(key:String, value:String):Void {
+        headers.set(key, value);
+    }
+
+    public function setPostData(value:String):Void {
+        postData = value;
+    }
+
+    public function request(post:Bool):Void {
+        var connection:HttpURLConnection = null;
+        try {
+            connection = cast new URL(url).openConnection();
+            var timeoutMilliseconds = Std.int(cnxTimeout * 1000);
+            connection.setConnectTimeout(timeoutMilliseconds);
+            connection.setReadTimeout(timeoutMilliseconds);
+            connection.setRequestMethod(post ? "POST" : "GET");
+            for (key => value in headers) {
+                connection.setRequestProperty(key, value);
+            }
+            if (post) {
+                connection.setDoOutput(true);
+                var output = connection.getOutputStream();
+                var bytes = Bytes.ofString(postData).getData();
+                output.write(bytes);
+                output.close();
+            }
+            var status = connection.getResponseCode();
+            onStatus(status);
+            if (status >= 400) {
+                onError("HTTP " + status);
+            } else {
+                var input = connection.getInputStream();
+                var response = new ByteArrayOutputStream();
+                var buffer = Bytes.alloc(8192).getData();
+                var count = input.read(buffer, 0, 8192);
+                while (count != -1) {
+                    response.write(buffer, 0, count);
+                    count = input.read(buffer, 0, 8192);
+                }
+                input.close();
+                var responseData = Bytes.ofData(response.toByteArray()).toString();
+                onData(responseData);
+            }
+        } catch (error:Dynamic) {
+            onError(Std.string(error));
+        }
+        if (connection != null) {
+            connection.disconnect();
+        }
+    }
+}
