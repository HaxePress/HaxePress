+    /** Writes in the system's append mode, so concurrent writers, including other processes, keep every record. */
+    public function append(path:String, data:String):Void {
+        var absolute = this.path(StoragePath.file(path));
+        createParents(Path.directory(absolute));
+        var existing = FileSystem.exists(absolute);
+        if (existing && FileSystem.isDirectory(absolute))
+            throw new StorageException("append to file", path);
+        #if php
+        var written:Dynamic = Syntax.code("\\file_put_contents({0}, {1}, \\FILE_APPEND | \\LOCK_EX)", absolute, data);
+        if (written == false) throw new StorageException("append to file", path);
+        #else
+        var output = File.append(absolute, true);
+        try {
+            output.writeString(data);
+            output.close();
+        } catch (e:Dynamic) {
+            try output.close() catch (_:Dynamic) {}
+            throw e;
+        }
+        #end
+        if (!existing) LocalPermissions.set(absolute, defaultVisibility, false);
+    }
+
