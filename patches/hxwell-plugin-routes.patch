+    /** Publish a complete registration/removal batch without exposing partial routes. */
+    public static function batch(callback:Void->Void,
+            ?decorate:RouteElement->Void):Array<RouteElement> {
+        var current = pending.get();
+        if (current != null) {
+            var start = current.created.length;
+            callback();
+            return current.created.slice(start).filter(route -> current.routes.contains(route));
+        }
+        routeWrites.acquire();
+        var groups = RouteElement.groups.copy();
+        var changes = new RouteChanges(routes, routeByName);
+        pending.set(changes);
+        try {
+            callback();
+            var added = changes.created.filter(route -> changes.routes.contains(route));
+            if (decorate != null) {
+                for (route in added) {
+                    decorate(route);
+                }
+            }
+            routes = changes.routes;
+            routeByName = changes.names;
+            pending.remove();
+            RouteElement.groups = groups;
+            routeWrites.release();
+            return added;
+        } catch (error:Dynamic) {
+            pending.remove();
+            RouteElement.groups = groups;
+            routeWrites.release();
+            throw error;
+        }
+    }
+
+    public static function unregister(route:RouteElement):Void {
+        var current = pending.get();
