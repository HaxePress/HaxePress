+     * released right after that call, and also when it can no longer be sent.
+     */
+    public function respondSlice(head:ResponseHead, slice:ResponseSlice):Void {
+        var send = () -> {
+            if(gone || completed || started) {
+                slice.release();
+                return;
+            }
+            var current = handler;
+            started = true;
+            release();
+            handler = null;
+            stream = null;
+            try UpstreamAccess.respondSlice(current, head, slice)
+            catch(error:Dynamic) {
+                UpstreamAccess.abort(current);
+                trace(error);
+            }
+            slice.release();
+        };
+        if(runtime.__isOwnThread()) send();
+        else if(!runtime.post(send)) {
+            slice.release();
+            throw new Exception("Crossbyte runtime has stopped");
+        }
+    }
