+    /**
+        Encodes text bodies into reusable buffers when an application installs
+        it. Without one, drivers read `toInput()`, which copies the text.
+    **/
+    public static var textEncoder:Null<String->ResponseSlice> = null;
+
+    /**
+        The body as bytes a driver may write without copying, or null when the
+        driver should read `toInput()`. A driver that takes a slice releases it
+        once the bytes are no longer needed.
+    **/
+    public function slice():Null<ResponseSlice> {
+        return null;
+    }
+
+    function encodedText(text:String):Null<ResponseSlice> {
+        var encode = textEncoder;
+        return encode == null || text == null ? null : encode(text);
+    }
+
     public function asStatic():Void {
         ResponseStatic.set(this);
