diff --git a/src/hx/well/http/ResponseSlice.hx b/src/hx/well/http/ResponseSlice.hx
new file mode 100644
index 0000000..2366be3
--- /dev/null
+++ b/src/hx/well/http/ResponseSlice.hx
@@ -0,0 +1,26 @@
+package hx.well.http;
+
+import haxe.io.Bytes;
+
+/**
+    A response body that a driver can write without copying: `bytes` from 0
+    to `length`. The driver calls `release` once it no longer reads `bytes`,
+    after which the owner may reuse the buffer. Releasing twice is harmless.
+**/
+class ResponseSlice {
+    public final bytes:Bytes;
+    public final length:Int;
+    var onRelease:Null<Void->Void>;
+
+    public function new(bytes:Bytes, length:Int, ?onRelease:Void->Void) {
+        this.bytes = bytes;
+        this.length = length;
+        this.onRelease = onRelease;
+    }
+
+    public function release():Void {
+        var callback = onRelease;
+        onRelease = null;
+        if(callback != null) callback();
+    }
+}
