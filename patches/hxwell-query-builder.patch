+
+    public static function upsert<T>(query:QueryBuilder<T>, columns:Array<String>,
+            uniqueBy:Array<String>, update:Array<String>):String {
+        if (uniqueBy == null || uniqueBy.length == 0 || update == null || update.length == 0) {
+            throw new Exception("Upsert requires conflict columns and update columns.");
+        }
+        for (column in uniqueBy.concat(update)) {
+            QueryIdentifier.quote(column);
+            if (!columns.contains(column)) {
+                throw new Exception("Every upsert column must have a supplied value.");
+            }
+        }
+        var statement = toString(query, columns.iterator());
+        var assignments = update.map(column -> '${QueryIdentifier.quote(column)} = ?').join(", ");
+        return switch (Connection.driver(query.model.__connection)) {
+            case "sqlite":
+                var conflict = uniqueBy.map(QueryIdentifier.quote).join(", ");
+                '${statement} ON CONFLICT (${conflict}) DO UPDATE SET ${assignments}';
+            case "mysql":
+                '${statement} ON DUPLICATE KEY UPDATE ${assignments}';
+            case driver:
+                throw new Exception('Upsert is not supported by database driver: ${driver}');
+        };
+    }
+
+    /** SQLite before 3.24 needs an update/conditional-insert inside a savepoint. */
+    public static function legacyUpsert<T>(query:QueryBuilder<T>, columns:Array<String>,
+            uniqueBy:Array<String>, update:Array<String>):Array<String> {
+        var table = QueryIdentifier.quote(query.model.getTable());
+        var predicate = uniqueBy.map(column -> '${QueryIdentifier.quote(column)} = ?').join(" AND ");
+        var assignments = update.map(column -> '${QueryIdentifier.quote(column)} = ?').join(", ");
+        var projection = columns.map(QueryIdentifier.quote).join(", ");
+        var placeholders = columns.map(_ -> "?").join(", ");
+        var exists = 'SELECT 1 FROM ${table} WHERE ${predicate}';
+        return [
+            'UPDATE ${table} SET ${assignments} WHERE ${predicate}',
+            'INSERT INTO ${table} (${projection}) SELECT ${placeholders} WHERE NOT EXISTS (${exists})'
+        ];
+    }
+}
