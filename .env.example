APP_NAME=haxepress
APP_ENV=development
APP_INSTALLED=false
# Direct 127.0.0.1 connections can always start setup. List other allowed peer IPs here.
INSTALL_TRUSTED_IPS=
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
MAX_CONNECTIONS=10000
WORKERS=16
MAX_CONTENT_LENGTH=67108864
DB_DRIVER=sqlite
DB_PATH=storage/cms.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
CACHE_PATH=storage/cache
CONTENT_CACHE_TTL=600
SESSION_PATH=storage/sessions
SESSION_LIFETIME=120
STORAGE_PATH=storage
VITE_USE_BUILD=true
VITE_INCLUDE_PAGE_ENTRY=false
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714/render
INERTIA_SSR_TIMEOUT=3
MCP_HOST_ENABLED=true
NODE_BINARY=node
MCP_ALLOWED_ORIGINS=
# Filled by the trusted-IP installation wizard. Keep the real .env private.
SITE_NAME=HaxePress
CMS_SEED_DEMO=false
ADMIN_NAME=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
