APP_NAME=haxepress
APP_ENV=development
APP_INSTALLED=false
# Direct 127.0.0.1 connections can always start setup. List other allowed peer IPs here.
INSTALL_TRUSTED_IPS=
# Opens setup from any connection, such as a Cloudflare Tunnel. Created and printed on the
# first start when empty, and removed when installation finishes.
INSTALL_KEY=
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
MAX_CONNECTIONS=10000
WORKERS=16
MAX_CONTENT_LENGTH=67108864
DB_DRIVER=sqlite
DB_PATH=private/database/cms.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
CACHE_PATH=private/storage/cache
CONTENT_CACHE_TTL=600
SESSION_PATH=private/storage/sessions
SESSION_LIFETIME=120
# Nothing under private/ is served; public/ is the web root.
STORAGE_PATH=private/storage
# SQLite databases the installer creates, kept apart from the files in STORAGE_PATH.
DATA_PATH=private/database
# The plugin and theme archives shipped with this release.
PACKAGES_PATH=private/packages
MCP_ALLOWED_ORIGINS=
# Filled by the trusted-IP installation wizard. Keep the real .env private.
SITE_NAME=HaxePress
# The language a new site starts with; more are added on the Languages page.
SITE_LANGUAGE=en
CMS_SEED_DEMO=false
# Only for installing without the wizard: the first administrator is created from these
# when no account exists, and they are then cleared. The wizard never writes them.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
